# Copia este archivo a .env y pon los valores. .env nunca se sube.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Opcional: ruta absoluta de la base compartida entre copias del repositorio
DESPACHOX_DB=
# Opcional: modelo que desempata lugares (por defecto claude-haiku-5-5)
DESPACHOX_MODELO_LUGARES=
# Opcional: modelo que lee los mensajes del bot (por defecto claude-haiku-5-5)
DESPACHOX_MODELO_ENTRADA=
# Opcional: sal del hash del remitente. Si falta, se crea sola en un archivo .sal junto a la base
DESPACHOX_SAL=
