# Copia este archivo a .env y pon los valores. .env nunca se sube.
# Las opcionales van comentadas: una variable vacía cuenta como definida y anula el valor por defecto.
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Opcional: ruta absoluta de la base compartida entre copias del repositorio
DESPACHOX_DB=
# Opcional: modelo que desempata lugares (por defecto claude-haiku-5-5)
# DESPACHOX_MODELO_LUGARES=
# Opcional: modelo que lee los mensajes del bot (por defecto claude-haiku-5-5)
# DESPACHOX_MODELO_ENTRADA=
# Opcional: sal del hash del remitente. Si falta, se crea sola en un archivo .sal junto a la base
# DESPACHOX_SAL=
# Opcional: notas de voz. Servicio con la interfaz /audio/transcriptions de OpenAI (OpenAI, Groq...).
# Sin clave, el bot pide escribir. El audio no se guarda; la transcripción se limpia como cualquier texto.
# DESPACHOX_VOZ_CLAVE=
# DESPACHOX_VOZ_URL=https://api.openai.com/v1/audio/transcriptions
# DESPACHOX_VOZ_MODELO=whisper-1
